{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@cora/contracts": ["packages/contracts/src/index.ts"],
      "@cora/contracts/*": ["packages/contracts/src/*"],
      "@cora/workspace-client": ["packages/workspace-client/src/index.ts"],
      "@cora/policy": ["packages/policy/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "apps/web", "apps/desktop"]
}
